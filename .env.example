# Copy to .env (untracked). Values come from `npx supabase status` after `npm run db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=
# Used only by scripts/seed.mjs (never shipped to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Local demo only. Choose your own; it is never committed.
DEMO_PASSWORD=
# Quick-login buttons on the login page (local demo only)
VITE_DEMO_QUICK_LOGINS=false
# Same value as DEMO_PASSWORD; only read when quick logins are on (local demo only)
VITE_DEMO_PASSWORD=
